---
import {company,businesses,esc,icon,flowSvg,plansHtml,candidateSteps,trainingSkills,softwareFeatures} from '../lib/content.mjs';
import '../styles/global.css';
import {jewelleryItems} from '../lib/jewellery.mjs';
export function getStaticPaths(){return ['', 'about','businesses','businesses/getjobme','businesses/bigshopes','businesses/gold-appraiser-training','businesses/prime-gold-software','businesses/thangamalai-jewellers','consulting','gallery','contact','faq'].map(path=>({params:{path:path||undefined}}));}
const path=Astro.params.path||'';
const b=businesses.find(x=>'businesses/'+x.slug===path);
const titles={'':'People. Commerce. Skills. Technology.','about':'Experience with purpose.','businesses':'Four businesses. One connected vision.','consulting':'Grow your showroom. Strengthen your business.','gallery':'Recent happenings.','faq':'Your questions, answered.','contact':'The right conversation starts here.','businesses/thangamalai-jewellers':'Beautiful jewellery. Thoughtful value.'};
const title=b?.title||titles[path];
const descriptions={'':'Canny Heads Consulting connects recruitment, online commerce, gold appraisal training and business software in Thanjavur.','about':'Practical experience across jewellery retail, e-commerce, recruitment and business systems.','businesses':'Explore GetJobMe, BigShopes, PrimeGold Academy and PrimeGold software.','consulting':'Jewellery retail consulting: sales performance, recruitment, customer experience, operating systems and business growth.','gallery':'Photos and updates from Canny Heads Consulting and its businesses.','faq':'Answers about jobs and hiring on GetJobMe, BigShopes jewellery stores, gold appraiser training, PrimeGold gold loan software and jewellery retail consulting.','contact':'Contact Canny Heads Consulting in Thanjavur for jobs, recruitment, jewellery stores, training and software.','businesses/thangamalai-jewellers':'Discover Thangamalai, the group’s own jewellery brand and an example store on BigShopes.'};
const description=b?.description||descriptions[path];
const canonical='https://www.cannyheads.com/'+path;
const heroImage=b?'/business/'+b.image:path==='about'?'/main/about-senior-team.webp':path==='consulting'?'/main/jewellery-consulting.webp':path.includes('thangamalai')?'/business/thangamalai-jewellery.webp':'/main/home-leadership.webp';
const faqs=b?.key==='getjobme'?[['Do candidates pay anything?','No. Registration, job search and applications are 100% free for candidates.'],['Can employers post unlimited jobs?','Yes. Employer registration and unlimited job posting are free.'],['How are matches chosen?','By role and location. View profiles, photos and available voice introductions, with matching alerts on WhatsApp/email.'],['When can I see candidate contacts?','Candidate contacts are protected. Choose a contact-credit plan; your account shows your available access and credits.'],['Can your team recruit for us?','Yes. Ask about Pro Recruitment or Recruitment Pro Max. Success fees apply when the candidate joins; a position advance is required.']]:b?.key==='bigshopes'?[['Is my jewellery store free?','Yes. Create an online jewellery store and show your catalogue free.'],['Where do enquiries go?','Directly to the jeweller, who follows up with the customer and does business directly. There is no commission on these enquiries.'],['Is the Gold Savings Scheme free too?','No. The optional scheme has a platform fee. Customer instalments go to the jeweller’s own Razorpay account.'],['Can other sellers join?','Yes. BigShopes supports general product categories. Choose Become a Vendor on BigShopes.']]:b?.key==='training'?[['How long is the course?','7 days at our Thanjavur centre: 6 days of theory and 1 practical day.'],['I live outside Thanjavur. Can I still join?','Yes. Attend the theory classes online, then do the 1-day practical in Thanjavur, or at your district headquarters: we organise a practical day there once 10 members from that district join.'],['What is the special offer?','₹5,000 + 18% GST for the full 7 days. Enquire to confirm the next batch.'],['Do you help with placement?','Yes. After the course, our GetJobMe team finds suitable employers and arranges interviews for you to get placed.']]:b?.key==='primegold'?[['Is this a loan service?','No. Canny Heads provides and supports software. It does not lend money.'],['Who is it for?','Gold-loan companies, pawnbroking shops and individual proprietorships.'],['How do we get started?','Request a demo, review your workflow, then plan configuration, data migration, staff training and ongoing support.']]:[];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{b?b.name+' | ':''}{title} | Canny Heads Consulting</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={'https://www.cannyheads.com'+heroImage}/><meta name="theme-color" content="#174A7E"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:company.name,url:'https://www.cannyheads.com',telephone:company.phone,email:company.email,address:{'@type':'PostalAddress',streetAddress:'3B, 2nd Floor, Nallaiyah Complex, 70 Srinivasam Pillai Road',addressLocality:'Thanjavur',addressRegion:'Tamil Nadu',postalCode:'613001',addressCountry:'IN'},location:{'@type':'Place',geo:{'@type':'GeoCoordinates',latitude:10.7784717,longitude:79.1418449},hasMap:'https://maps.google.com/?cid=7407210076967261167'},sameAs:['https://maps.google.com/?cid=7407210076967261167'],brand:{'@type':'Brand',name:'GetJobMe',url:'https://www.getjobme.com/'},subOrganization:{'@type':'Organization',name:'GetJobMe',url:'https://www.getjobme.com/'}})}/></head>
<body style={`--accent:${b?.textColor||b?.color||'#174A7E'};--accent2:${b?.secondary||'#132B27'}`}>
<a class="skip" href="#content">Skip to content</a>
<header><a class="brand" href="/" aria-label="Canny Heads home"><img src="/brand/canny-heads-logo.jpeg" alt="Canny Heads Consulting" width="150" height="64"/><span>Canny Heads<small>CONSULTING</small></span></a><nav aria-label="Main navigation"><a href="/about">About</a><a href="/businesses">Businesses</a><a href="/consulting">Consulting</a><a href="/gallery">Gallery</a><a href="/faq">FAQ</a><a class="nav-contact" href="/contact">Let’s talk ↗</a></nav></header>
<main id="content">
{path==='faq'? <section class="wrap section faq-page"><p class="kicker">Questions & answers</p><h1>Your questions, answered.</h1><p class="intro">Jobs and hiring on GetJobMe, BigShopes jewellery stores, gold appraiser training, PrimeGold software and our consulting. Can’t find your answer? Call or WhatsApp <a href="tel:+917200824009">72008 24009</a>.</p><label class="faq-search-label" for="faq-search">Search the questions</label><input id="faq-search" class="faq-search" type="search" autocomplete="off" placeholder="Type a word, e.g. free, gold, staff" data-faq-search/><div data-faq-content><p>__FAQ_CONTENT__</p></div><p class="faq-empty" data-faq-empty hidden>No matching question. Call or WhatsApp <a href="tel:+917200824009">72008 24009</a> and our team will help you.</p><script is:inline src="/faq.js" defer></script></section>:
path==='gallery'? <section class="wrap section"><p class="kicker">People, progress & moments</p><h1>Recent happenings.</h1><p class="intro">From our businesses, training sessions and team activities.</p><div class="filters" role="group" aria-label="Filter photos by business"><button data-gallery-filter="" aria-pressed="true">All</button>{businesses.map(x=><button data-gallery-filter={x.key} aria-pressed="false">{x.name}</button>)}<button data-gallery-filter="company" aria-pressed="false">Company</button></div><div data-gallery data-limit="24" class="gallery-grid" aria-live="polite"><p>Loading photos…</p></div><button class="button secondary" data-gallery-more hidden>Show more photos</button></section>:
<section class="hero wrap"><div><p class="kicker">{b?.eyebrow|| (path===''?'Canny Heads Consulting · Thanjavur':path==='businesses'?'The Canny Heads ecosystem':path.replace('businesses/','').replaceAll('-',' '))}</p>{b&&<div class="business-name"><Fragment set:html={icon(b.icon)}/>{b.name}</div>}<h1>{title}</h1><p class="intro">{description}</p><div class="actions"><a class="button" href={b?.link||'/businesses'}>{b?.cta||'Explore our businesses'} ↗</a><a class="text-link" href={b?'/contact':'/contact'}>Talk to our team →</a></div>{path===''&&<p class="hero-note">Built on systems. Driven by results.</p>}</div><figure><img src={heroImage} alt={b?b.name+' business illustration':path==='consulting'?'Jewellery retail consulting illustration':'Canny Heads business illustration'} width="1536" height="1024" fetchpriority="high"/><figcaption>{b?.name||'Canny Heads Consulting'} / A practical path forward</figcaption></figure></section>}
{(path===''||path==='businesses')&&<section class="wrap section"><div class="section-title"><p class="kicker">Connected by purpose</p><h2>Four ways to move forward.</h2><p>Find people. Reach customers. Build skills. Run stronger operations.</p></div><div class="business-grid">{businesses.map((x,i)=><a href={'/businesses/'+x.slug} class="business-card" style={`--card:${x.textColor||x.color}`}><span class="card-number">0{i+1}</span><div class="card-icon"><Fragment set:html={icon(x.icon)}/></div><p class="kicker">{x.eyebrow}</p><h3>{x.name}</h3><p>{x.description}</p><span class="card-link">Explore {x.name} ↗</span></a>)}</div></section>}
{b?.key==='getjobme'&&<><section class="band"><div class="wrap two-col"><div><p class="kicker">Start free. Hire with clarity.</p><h2>Unlimited jobs.<br/>Relevant people.</h2><p>Employers register and post unlimited jobs free. GetJobMe matches candidates by role and location and shows profiles, photos and available voice introductions.</p><p>Matching-candidate alerts arrive on WhatsApp/email. Candidate contacts remain protected until a free allowance or paid unlock applies.</p></div><div class="feature-box"><h3>Your hiring starts here</h3><ul><li>Free employer registration</li><li>Unlimited free job posting</li><li>Role + location matching</li><li>Protected candidate contacts</li></ul><a class="staff-callout" href="https://wa.me/917200824009?text=STAFF"><span>WHATSAPP <b>STAFF</b> TO</span><strong>72008 24009</strong></a><a href={b.link}>Register as an employer ↗</a></div></div></section><section class="wrap section"><p class="kicker">From vacancy to hire</p><h2>Your hiring journey.</h2><div class="flow" set:html={flowSvg()}/></section><section class="wrap section" id="plans"><p class="kicker">Choose the support you need</p><h2>Transparent employer plans.</h2><div set:html={plansHtml()}/><a class="text-link" href="https://www.getjobme.com/employer/services">View current plans on GetJobMe ↗</a></section><section class="band"><div class="wrap"><p class="kicker">For candidates</p><h2>Your next opportunity is always free.</h2><p>No candidate payment of any kind. Register on the website or WhatsApp <b>JOB</b> to +91 72008 24009. Our staff call you and arrange interviews with employers.</p><ol class="steps">{candidateSteps.map(x=><li>{x}</li>)}</ol><a class="button" href="https://www.getjobme.com/register?role=Candidate">Register free ↗</a><p lang="ta" class="tamil">வேலை தேடுபவர்களுக்கு பதிவு மற்றும் விண்ணப்பம் முற்றிலும் இலவசம்.</p></div></section></>}
{b?.key==='bigshopes'&&<><section class="band"><div class="wrap two-col"><div><p class="kicker">Jewellers, this is your space</p><h2>Your catalogue.<br/>Your customers.</h2><p>Create your online jewellery store FREE. Show your designs and let customers discover your catalogue. Enquiries go directly to you: follow up, discuss the requirement and do business directly.</p><p><b>No commission on jewellery enquiries.</b></p></div><div class="feature-box"><h3>From showroom to online discovery</h3><ol><li>Open BigShopes and choose “Become a Vendor”.</li><li>Create your jewellery store.</li><li>Add your catalogue and product details.</li><li>Receive enquiries and contact customers directly.</li></ol></div></div></section><section class="wrap section two-col"><div><p class="kicker">Optional for jewellers</p><h2>Gold Savings Scheme.</h2><p>Offer daily savings with UPI AutoPay and WhatsApp reminders. Ask about weekly payment options. Payments go straight into your own Razorpay account; AutoPay requires an active mandate and scheme setup.</p><p>This optional service has a platform fee. Ask us about setup and terms.</p></div><div><p class="kicker">A marketplace for every category</p><h2>More products.<br/>More possibilities.</h2><p>BigShopes is a multi-vendor online marketplace across product categories. General sellers can join through “Become a Vendor”.</p><p>Explore the group’s own jewellery brand, Thangamalai, as an example store.</p><a href="/businesses/thangamalai-jewellers">Meet Thangamalai ↗</a></div></section></>}
{b?.key==='bigshopes'&&<section class="wrap section"><p class="kicker">Build your jewellery store</p><h2>Your collection deserves to be seen.</h2><div class="jewellery-grid">{jewelleryItems.map(x=><figure><img src={x.src} alt={x.label} width={x.width} height={x.height} loading="lazy"/><figcaption>{x.label}</figcaption></figure>)}</div><p class="small">Examples from the BigShopes catalogue. Showcase your own designs in your store.</p><a class="button" href="https://bigshopes.com">Create your free store ↗</a></section>}
{b?.key==='bigshopes'&&<section class="wrap section vendor-enquiry"><p class="kicker">Vendor registration enquiries</p><h2>WhatsApp <b>VENDOR</b><br/>to <a href="https://wa.me/919345624009?text=VENDOR">93456 24009</a></h2><p>For jewellers and general sellers who want to join BigShopes.</p></section>}
{b?.key==='training'&&<><section class="band"><div class="wrap two-col"><div><p class="kicker">PrimeGold Academy</p><h2>6 days theory.<br/>1 day hands-on.</h2><p>Join the full 7 days at our Thanjavur centre. Outstation? Attend the theory classes online, then 1 practical day in Thanjavur, or at your district headquarters: we organise a practical day there once 10 members from that district join.</p><p lang="ta" class="tamil">தஞ்சாவூர் மையத்தில் 7 நாள் பயிற்சி: 6 நாள் தியரி + 1 நாள் நேரடி செய்முறைப் பயிற்சி. வெளியூர் நபர்கள் தியரியை ஆன்லைனில் படிக்கலாம்; 1 நாள் செய்முறைப் பயிற்சி தஞ்சாவூரில் அல்லது உங்கள் மாவட்டத் தலைநகரில் (அந்த மாவட்டத்தில் 10 பேர் சேர்ந்தவுடன்).</p></div><div class="offer"><span>Special offer</span><strong>₹5,000 <small>+ 18% GST</small></strong><p>For the full 7 days</p><a class="button" href="#gold-appraiser-enquiry">Enquire about the next batch ↓</a></div></div></section><section class="wrap section"><p class="kicker">What you learn</p><h2>Practical knowledge. Responsible appraisal.</h2><div class="pill-grid">{trainingSkills.map((x,i)=><article><span>0{i+1}</span><h3>{x}</h3></article>)}</div><div class="two-col section"><div><h3>Who it is for</h3><p>Aspiring appraisers, jewellery staff, gold-loan staff and job seekers.</p><h3>Certificate & career readiness</h3><p>Build a foundation for appraisal roles in jewellery and gold-loan companies. Through GetJobMe, we find suitable employers and arrange interviews for trained candidates to get placed.</p></div><video controls preload="none" poster="/business/gold-appraiser-training.webp"><source src="/videos/gold-appraiser-training-offer.mp4" type="video/mp4"/>Your browser does not support this video.</video></div></section></>}
{b?.key==='primegold'&&<><section class="band"><div class="wrap two-col"><div><p class="kicker">Built on Odoo ERP</p><h2>PrimeGold – Gold Loan Software Solutions.</h2><p>PrimeGold uses an internationally used, modular business platform as its foundation. Configure the software around your authorised gold-loan or pawnbroking operation.</p><p><b>Software only. Canny Heads does not lend money.</b></p></div><div class="feature-box"><h3>Made for your workflow</h3><div class="emi-highlight"><h3>Flexible gold-loan EMI repayments</h3><p>Customer repayment tenures: <b>3, 6, 8 or 11 months.</b></p></div><ul>{softwareFeatures.map(x=><li>{x}</li>)}</ul></div></div></section><section class="wrap section"><p class="kicker">A practical adoption journey</p><h2>From demonstration to daily use.</h2><ol class="steps four"><li>Request a demo</li><li>Review the workflow with your team</li><li>Configure, migrate data & train staff</li><li>Ongoing support</li></ol><a class="button" href={b.link}>Request a demo ↗</a></section></>}
{path==='about'&&<section class="wrap section two-col"><div><p class="kicker">Practical knowledge</p><h2>Built on systems.<br/>Driven by results.</h2><p>Our team brings more than 20 years of industry experience across jewellery retail, e-commerce and recruitment. We combine operating knowledge, clear strategy, capable people and dependable technology.</p><p>For jewellery retailers, we support showroom sales growth, recruitment, employee training, customer experience, operating systems and business expansion. For e-commerce businesses, we help clarify the model, market reach and growth priorities.</p></div><div class="feature-box"><h3>What guides us</h3><dl><dt>Clarity</dt><dd>Focused actions and understandable solutions.</dd><dt>Trust</dt><dd>Transparent communication and lasting relationships.</dd><dt>Usefulness</dt><dd>Ideas and services with practical value.</dd><dt>Progress</dt><dd>Keep learning, improving and building.</dd></dl></div></section>}
{path==='consulting'&&<section class="wrap section"><p class="kicker">Jewellery retail expertise</p><h2>Understand. Focus. Act.</h2><div class="pill-grid">{['Showroom growth strategy','Sales performance','Customer experience','People & recruitment','Retail systems & operations','Expansion & profitability'].map((x,i)=><article><span>0{i+1}</span><h3>{x}</h3><p>{['Set clear sales, margin, customer and expansion priorities.','Strengthen conversion, average bill value, presentation and follow-up.','Create a consistent journey from welcome to after-sales relationships.','Define roles, hire dependable teams and build leadership routines.','Improve daily processes, reporting and management visibility.','Plan branch growth, local marketing and operating discipline.'][i]}</p></article>)}</div><ol class="steps"><li>Understand your goals and operating reality</li><li>Focus on the changes that matter</li><li>Turn recommendations into action</li></ol><a class="button" href="https://wa.me/917200824009?text=I%20would%20like%20to%20discuss%20jewellery%20retail%20consulting">Discuss your showroom ↗</a></section>}
{path==='businesses/thangamalai-jewellers'&&<section class="wrap section two-col"><div><h2>Discover the group’s jewellery brand.</h2><p>Thangamalai Jewellers / thangamalai.me is Canny Heads’ own jewellery brand and a store on BigShopes. Explore designs for celebrations, gifting and everyday wear.</p><p>Thoughtful design, transparent product information and customer value guide the discovery experience.</p></div><div class="feature-box"><h3>Explore. Enquire. Connect.</h3><p>Browse jewellery, review the details and discuss your selection with the jeweller.</p><a class="button" href="https://www.thangamalai.me/">Explore Thangamalai ↗</a></div></section>}
{path==='contact'&&<section class="wrap section two-col"><div><h2>Visit or get in touch.</h2><address>{company.address}</address><p><a href="tel:+917200824009">{company.phone}</a><br/><a href="tel:+919500936499">{company.secondPhone}</a><br/><a href="mailto:info@cannyheads.com">{company.email}</a></p><a class="button" href="https://wa.me/917200824009">Message on WhatsApp ↗</a><p class="social"><a href="https://www.instagram.com/get_job_me/?hl=en">GetJobMe Instagram ↗</a><br/><a href="https://www.facebook.com/profile.php?id=61591617441542">Training Facebook ↗</a></p></div><div><h2>Choose your enquiry.</h2><p><b>Employers:</b> WhatsApp STAFF to 72008 24009.<br/><b>Candidates:</b> WhatsApp JOB to 72008 24009.<br/><b>Vendor registration:</b> WhatsApp <a href="https://wa.me/919345624009?text=VENDOR">VENDOR to 93456 24009</a>.</p>{businesses.map(x=><a class="contact-choice" href={x.key==='training'?x.link:'mailto:info@cannyheads.com?subject='+encodeURIComponent(x.name+' enquiry')}><span>{x.name}</span><span>↗</span></a>)}<a class="contact-choice" href="mailto:info@cannyheads.com?subject=Consulting%20enquiry">Jewellery consulting ↗</a></div></section>}
{b&&<section class="wrap section enquiry-end"><p class="kicker">{b.key==='getjobme'?'Recruitment enquiries':b.key==='training'?'Gold Appraiser Training enquiries':b.key==='primegold'?'Software and demo enquiries':'Jewellery / marketplace enquiries'}</p><h2>Reach us: <a href="tel:+917200824009">72008 24009</a></h2></section>}
{path==='contact'&&<section class="wrap section"><p class="kicker">All our businesses</p><h2>Scan or open a business.</h2><div class="contact-qr-grid">{businesses.map(x=><a href={x.key==='getjobme'?'https://www.getjobme.com':x.key==='bigshopes'?'https://bigshopes.com':'https://www.cannyheads.com/businesses/'+x.slug}><img src={'/qr/'+x.key+'.svg'} width="200" height="200" alt={'QR code for '+x.name}/><strong>{x.name}</strong><span>{x.key==='getjobme'?'www.getjobme.com':x.key==='bigshopes'?'www.bigshopes.com':'www.cannyheads.com/businesses/'+x.slug}</span></a>)}</div></section>}
{faqs.length>0&&<section class="wrap section faq"><p class="kicker">A few things to know</p><h2>Your questions, answered.</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>}
{path===''&&<section class="wrap section"><div class="section-title"><p class="kicker">Recent happenings</p><h2>People behind the progress.</h2><a href="/gallery">Explore the gallery ↗</a></div><div data-gallery data-limit="6" class="gallery-grid" aria-live="polite"><p>Loading photos…</p></div></section>}
{path!=='contact'&&path!=='gallery'&&<section class="closing"><div class="wrap"><p class="kicker">Let’s build what comes next</p><h2>A conversation can<br/>open a new direction.</h2><a class="button light" href="/contact">Connect with Canny Heads ↗</a></div></section>}
</main>
<footer><div class="wrap footer-grid"><div><img src="/brand/canny-heads-logo.jpeg" width="160" height="70" alt="Canny Heads Consulting"/><p>People. Commerce. Skills. Technology.</p><p>{company.address}</p><p><b>Thanjavur · Coimbatore, Tamil Nadu</b></p></div><div><h2>Our businesses</h2>{businesses.map(x=><a href={'/businesses/'+x.slug}>{x.name}</a>)}<a href="/businesses/thangamalai-jewellers">Thangamalai Jewellers</a></div><div><h2>Get in touch</h2><a href="tel:+917200824009">{company.phone}</a><a href="tel:+919500936499">{company.secondPhone}</a><a href="mailto:info@cannyheads.com">{company.email}</a><a href="/gallery">Recent happenings</a><a href="/faq">Questions & answers</a></div></div><div class="wrap legal"><span>© {new Date().getFullYear()} Canny Heads Consulting · GSTIN: {company.gstin}</span><div><a href="/privacy-policy">Privacy Policy</a><a href="/terms-and-conditions">Terms & Conditions</a><a href="/cancellation-refund-policy">Cancellation & Refund Policy</a></div></div></footer>
<dialog id="gallery-lightbox"><button aria-label="Close enlarged photo" data-lightbox-close>Close ✕</button><img alt=""/><p></p></dialog>
<script src="/gallery.js" defer is:inline></script>
</body></html>
