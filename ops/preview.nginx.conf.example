# TEMPLATE ONLY — not installed. DNS and certificate must exist first.
server {
    listen 443 ssl;
    server_name preview.cannyheads.com;
    ssl_certificate /etc/letsencrypt/live/preview.cannyheads.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/preview.cannyheads.com/privkey.pem;
    auth_basic "Canny Heads private preview";
    auth_basic_user_file /etc/nginx/htpasswd-canny-preview;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location / {
        proxy_pass http://127.0.0.1:4181;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
